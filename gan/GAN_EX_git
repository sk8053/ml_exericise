import pickle
# Hyperparameters etc
device = "cuda" if torch.cuda.is_available() else "cpu"
LEARNING_RATE = 1e-4
BATCH_SIZE = 64
IMAGE_SIZE = [64, 64]
CHANNELS_IMG = 1
Z_DIM = 10
NUM_EPOCHS = 5
FEATURES_CRITIC = 64
FEATURES_GEN = 64
CRITIC_ITERATIONS = 5
LAMBDA_gp= 10
#WEIGHT_CLIP = 0.01


with open('data_all.pickle','rb') as f:
    dataset = pickle.load(f)
print('data is loaded')
with open('loc_all.pickle','rb') as f:
